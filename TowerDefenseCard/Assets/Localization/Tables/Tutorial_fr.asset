%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: ddc349f0a26451848b441f5abb364850, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22915969024
    m_Localized: "\xC9coute bien, d\xE9fenseur ! Ta mission est simple : pr\xE9server
      l'int\xE9grit\xE9 de mon royaume. Essaie de ne pas tout g\xE2cher."
    m_Metadata:
      m_Items: []
  - m_Id: 22966300672
    m_Localized: "Ecoute-moi ! Tout d'abord, fabrique des cartes de d\xE9fense -
      fais-en beaucoup, tu en auras besoin. Ensuite, UTILISE les pour emp\xEAcher
      les ennemis d'envahir MON royaume. Compris ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22970494976
    m_Localized: "Quand la barre de progression est compl\xE8te, c'est l'heure du
      spectacle ! Il est temps de prouver que tu m\xE9rites de rester mon d\xE9fenseur."
    m_Metadata:
      m_Items: []
  - m_Id: 22970494977
    m_Localized: "Cette valeur indique le nombre de vagues \xE0 surmonter avant que
      je te d\xE9clare comp\xE9tent. Pas de pression !"
    m_Metadata:
      m_Items: []
  - m_Id: 22970494978
    m_Localized: "Ach\xE8te des boosters dans les boutiques, car tu auras besoin
      de toute l'aide possible !"
    m_Metadata:
      m_Items: []
  - m_Id: 22970494979
    m_Localized: "Clique sur ces boosters pour les ouvrir. Un concept r\xE9volutionnaire,
      je sais"
    m_Metadata:
      m_Items: []
  - m_Id: 9360233590784
    m_Localized: "Toutes tes id\xE9es de craft, soigneusement organis\xE9es. Je t'en
      prie, mes excellentes comp\xE9tences en organisation sont \xE0 ton service
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145216
    m_Localized: "N'h\xE9site pas \xE0 faire une pause et \xE0 r\xE9fl\xE9chir, je
      sais que la strat\xE9gie n'est pas ton point fort."
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145217
    m_Localized: "Acc\xE9l\xE9ration du temps disponible pour les impatients. Utilise-la
      si tu sais vraiment ce que tu fais."
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145218
    m_Localized: "Les raccourcis sont l\xE0 parce que je suis assez g\xE9n\xE9reux
      pour te faciliter la vie. Vas jeter un oeil dessus apr\xE8s."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160626044928
    m_Localized: Limite de carte atteinte ! Je sais, c'est choquant. Au lieu de paniquer,
      pourquoi ne pas essayer de construire une grange ?
    m_Metadata:
      m_Items: []
  - m_Id: 2672160672182272
    m_Localized: "D\xE9fenses maximales atteintes ! Essaie plut\xF4t de construire
      une maison au lieu de me regarder d'un air impuissant."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160680570880
    m_Localized: "S\xE9rieusement! Tu pr\xE9tends d\xE9fendre mon royaume et tu n'as
      pas encore craft de cartes de d\xE9fense ?!\nQu'est-ce que tu attends ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160684765184
    m_Localized: Comment ferais-tu sans moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 2672160688959488
    m_Localized: "Attention ! Notre royaume est menac\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160688959489
    m_Localized: Toujours debout ! Enfin... presque debout.
    m_Metadata:
      m_Items: []
  - m_Id: 2672160697348096
    m_Localized: On testait juste leur puissance de frappe. Pour la science !
    m_Metadata:
      m_Items: []
  - m_Id: 2672160701542400
    m_Localized: "Une ex\xE9cution parfaite ! ... m\xEAme si tu t'en ai pris plein
      la tronche."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160705736704
    m_Localized: "Eh bien, \xE7a sera d\xE9duit de ton salaire... si je te payais
      vraiment."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160709931008
    m_Localized: "Ne t'inqui\xE8te pas, je suis s\xFBr que les ennemis seront plus
      gentils la prochaine fois. Ils ont l'air raisonnables."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160718319616
    m_Localized: "Remarquable ! \xC0 ce rythme, je vais devoir trouver un nouveau
      royaume d'ici mardi."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160722513920
    m_Localized: "Excellent travail ! Je commen\xE7ais \xE0 m'ennuyer de voir mes
      murs intacts de toute fa\xE7on."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160730902528
    m_Localized: "Et voil\xE0 le travail. Prenez des notes !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160730902529
    m_Localized: "Pas une \xE9gratignure sur mon magnifique royaume. Je suppose que
      tu vas demander une augmentation maintenant ?\nComment \xE7a, tu n'es pas pay\xE9
      ?\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160735096832
    m_Localized: "Parfait ! Fais \xE7a \xE0 chaque fois et tout ira bien entre nous."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160743485440
    m_Localized: "Une d\xE9fense naturellement sans faille ! C'est pour \xE7a que
      je vous paie... n'est-ce pas ?\nComment \xE7a, tu n'es pas pay\xE9 ? "
    m_Metadata:
      m_Items: []
  - m_Id: 2672160747679744
    m_Localized: "Aucun d\xE9g\xE2t ? Je devrais probablement vous remercier... mais
      je ne le ferai pas. C'est ton travail apr\xE8s tout !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160751874048
    m_Localized: "Le temple est termin\xE9 ! Maintenant, passons aux choses s\xE9rieuses
      : il est temps de sortir l'artillerie lourde !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160756068352
    m_Localized: "Et voil\xE0 ! Pour une fois que tu n'es pas compl\xE9tement ridicule..."
    m_Metadata:
      m_Items: []
  - m_Id: 2672160764456960
    m_Localized: "Premier craft termin\xE9 ! Regardez qui a trouv\xE9 comment fabriquer
      quelque chose d'utile !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160768651264
    m_Localized: "Une usine ! Enfin quelqu'un qui comprend l'efficacit\xE9. Maintenant,
      on avance !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160772845568
    m_Localized: "Conseil de pro de votre g\xE9n\xE9reux souverain : maintenez la
      touche Maj enfonc\xE9e tout en d\xE9pla\xE7ant les cartes pour attirer les
      cartes similaires. Il n'y a pas de quoi !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160777039872
    m_Localized: "Tu manques d'encre pour tes boosters ? Vends simplement quelques
      cartes ! C'est ce qu'on appelle une \xAB r\xE9duction strat\xE9gique des effectifs
      \xBB - renseignes-toi !"
    m_Metadata:
      m_Items: []
  - m_Id: 2672160777039873
    m_Localized: "D\xE9pose des encres sur la boutique pour obtenir un booster !
      Ce n'est pas sorcier, c'est juste du shopping basique."
    m_Metadata:
      m_Items: []
  - m_Id: 11237037883912192
    m_Localized: "D\xE9placer la cam\xE9ra\n     <sprite name=z>\n<sprite name=q><sprite
      name=s><sprite name=d> ou <sprite name=mr>"
    m_Metadata:
      m_Items: []
  - m_Id: 11237342583320576
    m_Localized: 'Zoomer

      <sprite name=mm>'
    m_Metadata:
      m_Items: []
  - m_Id: 11237449185751040
    m_Localized: 'Pause

      <sprite name=space>'
    m_Metadata:
      m_Items: []
  - m_Id: 11237566206832640
    m_Localized: "Acc\xE9l\xE9rer/Ralentir\n<sprite name=e>"
    m_Metadata:
      m_Items: []
  - m_Id: 11237837666381824
    m_Localized: 'Voir le menu des crafts

      <sprite name=tab>'
    m_Metadata:
      m_Items: []
  - m_Id: 11237961654202368
    m_Localized: "Aimanter cartes de m\xEAme type\nMaintenir <sprite name=shift>"
    m_Metadata:
      m_Items: []
  - m_Id: 22862156355989504
    m_Localized: "\xC0 court de d\xE9fenses ? Quelle surprise... Je vais appeler
      les Yoka\xEFs et implorer leur piti\xE9 en ton nom. Une fois de plus..."
    m_Metadata:
      m_Items: []
  - m_Id: 22863945553801216
    m_Localized: "Toujours pas pr\xEAt ? Quelle surprise... J'appelle les Yoka\xEFs
      pour retarder leur attaque parce que mon \xAB d\xE9fenseur \xBB a oubli\xE9
      de d\xE9fendre."
    m_Metadata:
      m_Items: []
  - m_Id: 22864089716224000
    m_Localized: "Aucune d\xE9fense ? Quelle strat\xE9gie brillante ! Laisse moi
      appeler les Yoka\xEFs pour leur expliquer que mon d\xE9fenseur a besoin de
      faire une sieste d'abord."
    m_Metadata:
      m_Items: []
  - m_Id: 33348108233732096
    m_Localized: "Regarde, un marchand ! Essaie de l\xE2cher de l'encre sur lui !"
    m_Metadata:
      m_Items: []
  - m_Id: 33352062929727488
    m_Localized: "Je t'ai recrut\xE9 un autre ouvrier ! La prochaine fois, construis
      une taverne et fais-le toi-m\xEAme !"
    m_Metadata:
      m_Items: []
  - m_Id: 51494391778766848
    m_Localized: Cliquer pour plus d'information
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
