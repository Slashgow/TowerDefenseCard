  - m_Id: 12719334223880
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re du Bambou."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223881
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re des Sakuras."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223882
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re de la Jade."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223883
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re de l'Amethyste"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223884
    m_Localized: "Un b\xE2timent d\xE9fensif permettant de r\xE9duire la vitesse
      des ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223885
    m_Localized: "Un archer tirant des fl\xE8ches monocibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223886
    m_Localized: "Dieu de la guerre.\nIl tire trois fl\xE8ches \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223887
    m_Localized: "Un chien loyal mordant un ennemi \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223888
    m_Localized: "Mi-chien, mi-lion, mordant les ennemis en AOE.\nSes d\xE9gats sont
      renforc\xE9s si un autre Komainu est dans sa port\xE9e d'attaque"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223889
    m_Localized: "Grue japonaise.\nIl inflige de faibles d\xE9g\xE2ts en AOE en 
      battant ses ailes."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223890
    m_Localized: "Cr\xE9ature mythologique, br\xFBle ses ennemis sur la dur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223891
    m_Localized: "Serpent blanc empoisonnant un ennemi \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223892
    m_Localized: "Cr\xE9ature mythologique, lance des boules de feus sur ses ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223893
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223894
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223895
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223896
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223897
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223898
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223899
    m_Localized: Augmente la vitesse d'attaque
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223900
    m_Localized: "Augmente les d\xE9g\xE2ts"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223901
    m_Localized: "Ajoute des d\xE9g\xE2ts de brulure."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223902
    m_Localized: Augmente la zone d'attaque
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418176
    m_Localized: "Augmente la port\xE9e d'attaque"
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418177
    m_Localized: "Un d\xE9mon infligeant des d\xE9g\xE2ts monocibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418178
    m_Localized: "Un d\xE9mon infligeant des d\xE9g\xE2ts monocibles. Court rapidement"
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418179
    m_Localized: "Une cr\xE9ature semblable \xE0 une tortue infligeant des d\xE9g\xE2ts
      monocibles"
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418180
    m_Localized: Permet de stocker un faible nombre de cartes en plus.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418181
    m_Localized: "Permet de stocker une grande quantit\xE9 de cartes en plus."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418183
    m_Localized: Dieu du vent, peut repousser les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418184
    m_Localized: Dieu de la foudre, foudroie les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418185
    m_Localized: Dieu du soleil, peut aveugler les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418186
    m_Localized: "Dieu des temp\xEAtes, peut stun les ennemis en zone."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418187
    m_Localized: "Dieu de l'agriculture et de la m\xE9decine, peut soigner ses alli\xE9s
      en zone."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418188
    m_Localized: "Serpents \xE0 8 t\xEAtes, empoisonnent ses ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418189
    m_Localized: "Lieu sacr\xE9, n\xE9cessaire pour pour craft des Dieux."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418190
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418191
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418192
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418193
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418194
    m_Localized: "Un travailleur d\xE9di\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418195
    m_Localized: Court vite et griffe ses ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418196
    m_Localized: Aveugle tout les ennemis se trouvant dans son champ de vision.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418197
    m_Localized: "Court vite. Envoie des boules de feu, laissant ses ennemis br\xFBler."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418198
    m_Localized: Peut contenir de l'encre.
    m_Metadata:
      m_Items: []
