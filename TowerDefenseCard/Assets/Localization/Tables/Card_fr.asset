  - m_Id: 12719334223880
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re du Bambou."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223881
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re des Sakuras."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223882
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re de la Jade."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223883
    m_Localized: "Un b\xE2timent utilitaire qui g\xE9n\xE8re des Essences d'Esprit."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223884
    m_Localized: "Un b\xE2timent d\xE9fensif permettant de r\xE9duire la vitesse
      des ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223885
    m_Localized: "Un archer tirant des fl\xE8ches monocibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223886
    m_Localized: "Dieu de la guerre.\nIl tire trois fl\xE8ches \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223887
    m_Localized: "Un chien loyal mordant un ennemi \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223888
    m_Localized: "Mi-chien, mi-lion, mordant les ennemis en AOE.\nSes d\xE9gats sont
      renforc\xE9s si un autre Komainu est dans sa port\xE9e d'attaque"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223889
    m_Localized: "Grue japonaise.\nIl inflige de faibles d\xE9g\xE2ts en AOE en 
      battant ses ailes."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223890
    m_Localized: "Cr\xE9ature mythologique, br\xFBle ses ennemis sur la dur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223891
    m_Localized: "Serpent blanc empoisonnant un ennemi \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223892
    m_Localized: "Cr\xE9ature mythologique, lance des boules de feus sur ses ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223893
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223894
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
