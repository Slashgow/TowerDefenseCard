    m_Metadata:
      m_Items: []
  - m_Id: 12719334223897
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223898
    m_Localized: Ressource de base
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223899
    m_Localized: Augmente la vitesse d'attaque
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223900
    m_Localized: "Augmente les d\xE9g\xE2ts"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223901
    m_Localized: "Augmente les d\xE9g\xE2ts"
    m_Metadata:
      m_Items: []
  - m_Id: 12719334223902
    m_Localized: "Ressource de base. Peut \xEAtre utile pour construire une taverne."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418176
    m_Localized: Augmente le soin.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418177
    m_Localized: "Un d\xE9mon infligeant des d\xE9g\xE2ts monocibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418178
    m_Localized: "Un d\xE9mon infligeant des d\xE9g\xE2ts monocibles. Court rapidement"
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418179
    m_Localized: "Une cr\xE9ature semblable \xE0 une tortue infligeant des d\xE9g\xE2ts
      monocibles"
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418180
    m_Localized: Permet de stocker un faible nombre de cartes en plus.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418181
    m_Localized: "Permet de stocker une grande quantit\xE9 de cartes en plus."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418183
    m_Localized: Dieu du vent, peut repousser les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418184
    m_Localized: Dieu de la foudre, foudroie les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418185
    m_Localized: Dieu du soleil, peut aveugler les ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418186
    m_Localized: "Dieu des temp\xEAtes, peut stun les ennemis en zone."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418187
    m_Localized: "Dieu de l'agriculture et de la m\xE9decine, peut soigner ses alli\xE9s
      en zone."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418188
    m_Localized: "Serpents \xE0 8 t\xEAtes, empoisonnent ses ennemis."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418189
    m_Localized: "Lieu sacr\xE9, n\xE9cessaire pour pour craft des Dieux."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418190
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418191
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418192
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418193
    m_Localized: "Cette carte peut \xEAtre exploit\xE9e pour obtenir des ressources
      de base."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418194
    m_Localized: "Un travailleur d\xE9di\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418195
    m_Localized: Court vite et griffe ses ennemis en zone.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418196
    m_Localized: Aveugle tout les ennemis se trouvant dans son champ de vision.
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418197
    m_Localized: "Court vite. Envoie des boules de feu, laissant ses ennemis br\xFBler."
    m_Metadata:
      m_Items: []
  - m_Id: 12719338418198
    m_Localized: Peut contenir de l'encre.
    m_Metadata:
      m_Items: []
