  m_SharedData: {fileID: 11400000, guid: ddc349f0a26451848b441f5abb364850, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22915969024
    m_Localized: The goal of the game is to keep your kingdom alive.
    m_Metadata:
      m_Items: []
  - m_Id: 22966300672
    m_Localized: The game alternates between a preparation phase, where you must
      craft as many defense cards as possible, and a defense phase, where you must
      prevent enemies from reaching your kingdom.
    m_Metadata:
      m_Items: []
  - m_Id: 22970494976
    m_Localized: The defense phase begins when the progress bar is complete.
    m_Metadata:
      m_Items: []
  - m_Id: 22970494977
    m_Localized: You can see the number of waves you need to defeat to win the game.
    m_Metadata:
      m_Items: []
  - m_Id: 22970494978
    m_Localized: You can buy card boosters in shops.
    m_Metadata:
      m_Items: []
  - m_Id: 22970494979
    m_Localized: Open boosters by clicking on them
    m_Metadata:
      m_Items: []
  - m_Id: 9360233590784
    m_Localized: You can access your craft ideas here.
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145216
    m_Localized: You can pause the game to calmly prepare your defenses.
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145217
    m_Localized: It is possible to speed up time to craft faster.
    m_Metadata:
      m_Items: []
  - m_Id: 9360267145218
    m_Localized: Shortcuts are available here.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
