.UpperBand {
    height: 10%;
    justify-content: flex-start;
    align-items: auto;
    align-content: auto;
    flex-direction: row;
    width: 100%;
    flex-grow: 0;
    align-self: flex-end;
}

.unity-progress-bar {
    width: 30%;
    height: 100%;
    align-self: flex-end;
    align-content: auto;
    justify-content: center;
    align-items: auto;
    flex-grow: 1;
    flex-shrink: 0;
}

.unity-progress-bar__container {
    height: 100%;
    max-height: 50px;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
}

.unity-progress-bar__background {
    background-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 29, 40);
    border-right-color: rgb(0, 29, 40);
    border-top-color: rgb(0, 29, 40);
    border-bottom-color: rgb(0, 29, 40);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.unity-progress-bar__progress {
    background-color: rgb(246, 243, 236);
}
