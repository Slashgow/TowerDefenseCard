.background {
    background-color: rgb(255, 213, 90);
}

.Buttons {
    align-items: auto;
    align-content: auto;
}

.text-button {
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Font/Greattool-51Zoj.otf?fileID=12800000&guid=0f0dbd08a20d8ed4a93e7593e893fde4&type=3#Greattool-51Zoj");
    font-size: 80px;
}

.Button:hover {
    background-color: rgb(124, 28, 28);
    transition-duration: 0.2s;
    transition-property: scale;
    scale: 1.2 1.2;
}

.Button {
    width: 100%;
    align-items: auto;
    align-self: center;
    justify-content: flex-start;
    align-content: auto;
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 31px;
    margin-right: 31px;
    margin-bottom: 31px;
    margin-left: 31px;
    background-color: rgb(200, 74, 54);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 43px;
    border-top-right-radius: 43px;
    border-bottom-right-radius: 43px;
    border-bottom-left-radius: 43px;
}

.title {
    -unity-font-definition: url("project://database/Assets/Font/Greattool-51Zoj.otf?fileID=12800000&guid=0f0dbd08a20d8ed4a93e7593e893fde4&type=3#Greattool-51Zoj");
    font-size: 188px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 7.3px 6.9px 0 rgb(0, 0, 0);
    color: rgb(200, 74, 54);
}
